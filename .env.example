# Gemini API Key (Google AI Studio または Google Cloud から取得)
GEMINI_API_KEY=your_gemini_api_key_here

# 使用するGeminiモデル名（デフォルト: gemini-2.5-flash）
GEMINI_MODEL=gemini-2.5-flash

# Google スプレッドシート設定
# サービスアカウント鍵ファイルのパス
GOOGLE_CREDENTIALS_PATH=credentials.json

# スプレッドシート名 または スプレッドシートID
SPREADSHEET_NAME_OR_KEY=家計簿
# 記録対象のワークシート名（省略時は1枚目）
WORKSHEET_NAME=シート1

# ディレクトリ設定（相対パスまたは絶対パス）
INBOX_DIR=receipts/inbox
ARCHIVE_DIR=receipts/archive
FAILED_DIR=receipts/failed
