# Google Cloud & Vertex AI 設定 (サービスアカウント認証)
GOOGLE_CLOUD_PROJECT=apps-466614
GOOGLE_CLOUD_LOCATION=us
GOOGLE_APPLICATION_CREDENTIALS=credentials/service_account.json

# 使用するGeminiモデル名 & 画像圧縮設定（コスト最適化）
GEMINI_MODEL=gemini-3.5-flash
MAX_IMAGE_SIZE=1024
JPEG_QUALITY=80

# Google スプレッドシート設定
# スプレッドシートID (URLの /d/ と /edit の間の文字列)
SPREADSHEET_ID=your_spreadsheet_id_here
# 記録対象のワークシート名
WORKSHEET_NAME=シート1

# ディレクトリ設定（相対パスまたは絶対パス）
INBOX_DIR=receipts/inbox
ARCHIVE_DIR=receipts/archive
FAILED_DIR=receipts/failed
